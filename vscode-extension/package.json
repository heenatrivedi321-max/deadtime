{
  "name": "meanwhile",
  "displayName": "Meanwhile",
  "description": "A quiet line in your status bar while you code. Occasionally a disclosed sponsor line -- half the revenue is yours.",
  "version": "0.1.5",
  "publisher": "meanwhile-dev",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/heenatrivedi321-max/deadtime.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://trymeanwhile.online/install",
  "bugs": {
    "url": "https://github.com/heenatrivedi321-max/deadtime/issues"
  },
  "keywords": ["status bar", "earnings", "sponsor", "ambient"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "meanwhile.claim",
        "title": "Meanwhile: Check Earnings"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.4.0"
  }
}
